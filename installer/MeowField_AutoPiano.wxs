<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
      Name="MeowField_AutoPiano"
      Manufacturer="薮猫"
      Version="$(var.Version)"
      UpgradeCode="B13986BA-61E9-4D56-8A2B-3D2B01D17D33"
      Scope="perMachine">
    <SummaryInformation Description="MeowField_AutoPiano Windows MIDI 自动演奏工具" />
    <MajorUpgrade DowngradeErrorMessage="已安装更高版本的 MeowField_AutoPiano。" />
    <MediaTemplate EmbedCab="yes" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="MeowField_AutoPiano" />
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" Name="MeowField_AutoPiano" />
    </StandardDirectory>

    <Feature Id="MainFeature" Title="MeowField_AutoPiano" Level="1">
      <ComponentGroupRef Id="ApplicationFiles" />
      <Component Id="ApplicationShortcuts" Directory="ApplicationProgramsFolder" Bitness="always64">
        <Shortcut Id="StartMenuShortcut" Name="MeowField_AutoPiano" Target="[INSTALLFOLDER]MeowField_AutoPiano.exe" WorkingDirectory="INSTALLFOLDER" />
        <RemoveFolder Id="RemoveApplicationProgramsFolder" On="uninstall" />
        <RegistryValue Root="HKCU" Key="Software\薮猫\MeowField_AutoPiano" Name="Installed" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </Feature>
  </Package>

  <Fragment>
    <ComponentGroup Id="ApplicationFiles" Directory="INSTALLFOLDER">
      <Files Include="$(var.PublishDir)\**" />
    </ComponentGroup>
  </Fragment>
</Wix>
