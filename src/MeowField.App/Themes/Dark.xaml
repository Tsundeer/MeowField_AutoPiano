<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="Color.Surface.App">#141722</Color>
    <Color x:Key="Color.Surface.Panel">#CC252A38</Color>
    <Color x:Key="Color.Surface.Subtle">#A6313849</Color>
    <Color x:Key="Color.Text.Primary">#F2F4F8</Color>
    <Color x:Key="Color.Text.Secondary">#AEB6C8</Color>
    <Color x:Key="Color.Border.Default">#3C4458</Color>
    <Color x:Key="Color.Accent.Primary">#5B9BFF</Color>
    <Color x:Key="Color.Accent.Hover">#7FB5FF</Color>
    <Color x:Key="Color.Accent.Soft">#B31C3160</Color>
    <Color x:Key="Color.Status.Success">#68D391</Color>
    <Color x:Key="Color.Status.Warning">#F6C453</Color>
    <Color x:Key="Color.Status.Danger">#FF8191</Color>
    <SolidColorBrush x:Key="Brush.Surface.App" Color="{StaticResource Color.Surface.App}" />
    <SolidColorBrush x:Key="Brush.Surface.Panel" Color="{StaticResource Color.Surface.Panel}" />
    <SolidColorBrush x:Key="Brush.Surface.Glass" Color="#FF1A1F2C" />
    <SolidColorBrush x:Key="Brush.Surface.Card" Color="#FF1C212E" />
    <SolidColorBrush x:Key="Brush.Surface.Popup" Color="#252A38" />
    <SolidColorBrush x:Key="Brush.Border.Glass" Color="#33FFFFFF" />
    <DrawingBrush x:Key="Brush.Card.Texture" TileMode="Tile" Viewport="0,0,6,6" ViewportUnits="Absolute" Opacity="0.06">
        <DrawingBrush.Drawing>
            <GeometryDrawing Brush="#445A7C">
                <GeometryDrawing.Geometry>
                    <EllipseGeometry Center="3,3" RadiusX="0.8" RadiusY="0.8" />
                </GeometryDrawing.Geometry>
            </GeometryDrawing>
        </DrawingBrush.Drawing>
    </DrawingBrush>
    <LinearGradientBrush x:Key="Brush.Accent.Gradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#4C7DFF" />
        <GradientStop Color="#2A54D8" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="Brush.Surface.Subtle" Color="{StaticResource Color.Surface.Subtle}" />
    <SolidColorBrush x:Key="Brush.Text.Primary" Color="{StaticResource Color.Text.Primary}" />
    <SolidColorBrush x:Key="Brush.Text.Secondary" Color="{StaticResource Color.Text.Secondary}" />
    <SolidColorBrush x:Key="Brush.Border.Default" Color="{StaticResource Color.Border.Default}" />
    <SolidColorBrush x:Key="Brush.Accent.Primary" Color="{StaticResource Color.Accent.Primary}" />
    <SolidColorBrush x:Key="Brush.Accent.Hover" Color="{StaticResource Color.Accent.Hover}" />
    <SolidColorBrush x:Key="Brush.Accent.Soft" Color="{StaticResource Color.Accent.Soft}" />
    <SolidColorBrush x:Key="Brush.Status.Success" Color="{StaticResource Color.Status.Success}" />
    <SolidColorBrush x:Key="Brush.Status.Warning" Color="{StaticResource Color.Status.Warning}" />
    <SolidColorBrush x:Key="Brush.Status.Danger" Color="{StaticResource Color.Status.Danger}" />
</ResourceDictionary>
