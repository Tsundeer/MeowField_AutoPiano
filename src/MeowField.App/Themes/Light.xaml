<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="Color.Surface.App">#EAF2FD</Color>
    <Color x:Key="Color.Surface.Panel">#D9FFFFFF</Color>
    <Color x:Key="Color.Surface.Subtle">#99EEF4FD</Color>
    <Color x:Key="Color.Text.Primary">#1F2A44</Color>
    <Color x:Key="Color.Text.Secondary">#5E6A82</Color>
    <Color x:Key="Color.Border.Default">#D3DEF0</Color>
    <Color x:Key="Color.Accent.Primary">#2F6BF5</Color>
    <Color x:Key="Color.Accent.Hover">#1E5AEC</Color>
    <Color x:Key="Color.Accent.Soft">#B3DCE8FF</Color>
    <Color x:Key="Color.Status.Success">#2F855A</Color>
    <Color x:Key="Color.Status.Warning">#B7791F</Color>
    <Color x:Key="Color.Status.Danger">#C24155</Color>

    <SolidColorBrush x:Key="Brush.Surface.App" Color="{StaticResource Color.Surface.App}" />
    <SolidColorBrush x:Key="Brush.Surface.Panel" Color="{StaticResource Color.Surface.Panel}" />
    <SolidColorBrush x:Key="Brush.Surface.Glass" Color="#FFF4F8FF" />
    <SolidColorBrush x:Key="Brush.Surface.Card" Color="#FFF6F9FF" />
    <SolidColorBrush x:Key="Brush.Surface.Popup" Color="#FCFDFF" />
    <DrawingBrush x:Key="Brush.Card.Texture" TileMode="Tile" Viewport="0,0,6,6" ViewportUnits="Absolute" Opacity="0.08">
        <DrawingBrush.Drawing>
            <GeometryDrawing Brush="#A0B8D8">
                <GeometryDrawing.Geometry>
                    <EllipseGeometry Center="3,3" RadiusX="0.8" RadiusY="0.8" />
                </GeometryDrawing.Geometry>
            </GeometryDrawing>
        </DrawingBrush.Drawing>
    </DrawingBrush>
    <SolidColorBrush x:Key="Brush.Border.Glass" Color="#E6FFFFFF" />
    <LinearGradientBrush x:Key="Brush.Accent.Gradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#4F8CFF" />
        <GradientStop Color="#2A5FEA" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="Brush.Surface.Subtle" Color="{StaticResource Color.Surface.Subtle}" />
    <SolidColorBrush x:Key="Brush.Text.Primary" Color="{StaticResource Color.Text.Primary}" />
    <SolidColorBrush x:Key="Brush.Text.Secondary" Color="{StaticResource Color.Text.Secondary}" />
    <SolidColorBrush x:Key="Brush.Border.Default" Color="{StaticResource Color.Border.Default}" />
    <SolidColorBrush x:Key="Brush.Accent.Primary" Color="{StaticResource Color.Accent.Primary}" />
    <SolidColorBrush x:Key="Brush.Accent.Hover" Color="{StaticResource Color.Accent.Hover}" />
    <SolidColorBrush x:Key="Brush.Accent.Soft" Color="{StaticResource Color.Accent.Soft}" />
    <SolidColorBrush x:Key="Brush.Status.Success" Color="{StaticResource Color.Status.Success}" />
    <SolidColorBrush x:Key="Brush.Status.Warning" Color="{StaticResource Color.Status.Warning}" />
    <SolidColorBrush x:Key="Brush.Status.Danger" Color="{StaticResource Color.Status.Danger}" />
</ResourceDictionary>
